{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": [
      "node"
    ],
    "lib": [
      "ES2023",
      "DOM"
    ],
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "noEmitOnError": true
  },
  "include": [
    "apps/host/src/**/*.ts",
    "apps/inference/src/**/*.ts",
    "packages/bridge/src/page-endpoint.ts",
    "packages/bridge/src/page-transport.ts"
  ]
}
